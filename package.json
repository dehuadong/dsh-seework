{
  "name": "dsh-seework",
  "description": "SeeWork — DeepSeek Harness plugin for SeeAI Hub: generate images inside the agent conversation with your own SeeAI Hub API key (OpenAI-compatible /v1/images/generations), browse everything you generated in the sidebar material library, and arrange it on a canvas.",
  "version": "0.1.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dehuadong/dsh-seework.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "image-generation",
    "seeai"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cosmokit": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.1",
    "@deepseek-ai/dsh-skill": "0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^25.0.1",
    "lightningcss": "^1.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.15.6",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "sync": "node scripts/sync-to-profile.mjs",
    "probe": "node scripts/probe-host-bundle.mjs",
    "verify-live": "node scripts/verify-live.mjs"
  }
}
